# Cursor — keep project rules; ignore local/editor-only artifacts under .cursor/
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Dev/editor files
# Supabase URL + anon/publishable key
# online-config.js is committed so GitHub Pages can load it (anon/publishable keys are safe to expose)
# Claude Code config — commit project-wide agents/commands/skills/hooks/settings,
# but exclude per-user overrides and local scratch.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json

node_modules/
screenshots/
tests/visual/__screens__/

# Auto-generated debug artifacts (regenerated by scripts/debug/* on demand).
# Ignore generated reports but keep the authored deviations rationale tracked.
tests/reports/*
!tests/reports/deviations.md
agent-state/symbol-index.json
agent-state/symbol-negative-cache.json
agent-state/ANCHOR_INDEX.md
scripts/debug/_repro/
agent-state/playtest/
agent-state/playthrough/
agent-state/tmp/
.DS_Store
Thumbs.db
*.log

# Dev/debug scripts
*.py
analyzer.js
generate_report.js

# Agent/dev scratch repros (throwaway; promote to tests/suites/*.test.js if kept)
tests/_probe_*
tests/_scratch_*

# Unused data files (not loaded by game)
data/learnsets.json
data/formats-data.json
data/baseStats.json
data/types.json
data/types_smogon.json

# Unused asset folders
extra assets/

# Generated design artifacts (delivered to the user as files, regenerated on demand;
# the authored design canon lives in the tracked *.md docs).
STORY_MASTER.xlsx
*.xlsx
