{
  "name": "pokemon-battle",
  "private": true,
  "scripts": {
    "start": "node scripts/dev-server.cjs",
    "start:debug": "node scripts/debug/dev-server-debug.cjs",
    "sync-showdown-data": "node scripts/sync-showdown-data.js",
    "mirror-category-icons": "node scripts/mirror-showdown-category-icons.mjs",
    "mirror-trainers": "node scripts/mirror-showdown-trainers.mjs",
    "sprites:download": "node scripts/download-mega-gmax-sprites.mjs",
    "sprites:manifest": "node scripts/build-sprite-manifest.mjs",
    "sprites:optimize": "node scripts/optimize-sprites.mjs",
    "sprites:verify": "node scripts/verify-sprites.mjs",
    "test": "node --test --test-concurrency=4 'tests/**/*.test.js'",
    "test:property": "node --test 'tests/property/**/*.test.js'",
    "test:suites": "node --test 'tests/suites/**/*.test.js'",
    "test:moves": "node --test 'tests/moves/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.test.js'",
    "audit": "node tests/audit/coverage-report.js",
    "audit:csv": "node tests/audit/coverage-report.js --csv-only",
    "report:power-curve": "node tests/audit/power-curve.mjs",
    "lint": "eslint scripts/ tests/ online-pvp.js move-anim-map.js move-sfx-map.js online-config.example.js",
    "debug:anchors": "node scripts/debug/symbol-index.mjs && node scripts/debug/anchor-map.mjs",
    "debug:data": "node scripts/debug/data-validator.mjs",
    "debug:spec-drift": "node scripts/debug/spec-drift.mjs",
    "debug:perf": "node scripts/debug/perf-bench.mjs",
    "debug:replay": "node scripts/debug/story-replay.mjs diff",
    "debug:ledger": "node scripts/debug/issue-ledger.mjs"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1"
  }
}
