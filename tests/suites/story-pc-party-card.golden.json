{
  "PC_PARTY": "<div class=\"pc-card tier-1\" data-pc-row=\"party\" data-pc-id=\"fix-garchomp\"> <div class=\"pc-card-hit\" role=\"button\" tabindex=\"0\" data-pc-open=\"1\" aria-label=\"View Garchomp summary\" title=\"View full summary\"> <div class=\"pc-card-sprite-wrap\"> <img src=\"sprites/gen5ani/garchomp.gif\" alt=\"\" class=\"pc-card-sprite\" data-shiny=\"false\" style=\"\" onerror=\"this.style.display='none'\"> <span class=\"pc-card-grade\"><span style=\"display:inline-block;font-size:9px;font-weight:bold;color:#111;background:#ce93d8;padding:1px 5px;border-radius:0;letter-spacing:0.04em;\">G1</span></span> </div> <div class=\"pc-card-name\">Garchomp</div> <div class=\"pc-card-types\"><span class=\"type-badge type-Dragon\" onmousemove=\"window.showTypeTooltip('Dragon', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Dragon</span><span class=\"type-badge type-Ground\" onmousemove=\"window.showTypeTooltip('Ground', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Ground</span></div> </div> <div class=\"pc-card-actions\"><button type=\"button\" class=\"pc-card-btn pc-card-btn--deposit\" onclick=\"event.stopPropagation();window.StoryMode.pcDeposit('fix-garchomp')\" title=\"\">Deposit</button></div> </div>",
  "PC_PARTY_NICK": "<div class=\"pc-card tier-4\" data-pc-row=\"party\" data-pc-id=\"fix-eevee\"> <div class=\"pc-card-hit\" role=\"button\" tabindex=\"0\" data-pc-open=\"1\" aria-label=\"View Fluffy summary\" title=\"View full summary\"> <div class=\"pc-card-sprite-wrap\"> <img src=\"sprites/gen5ani/eevee.gif\" alt=\"\" class=\"pc-card-sprite\" data-shiny=\"false\" style=\"\" onerror=\"this.style.display='none'\"> <span class=\"pc-card-grade\"><span style=\"display:inline-block;font-size:9px;font-weight:bold;color:#111;background:#bcaaa4;padding:1px 5px;border-radius:0;letter-spacing:0.04em;\">G4</span></span> </div> <div class=\"pc-card-name\">\"Fluffy\"</div> <div class=\"pc-card-species\">Eevee</div> <div class=\"pc-card-types\"><span class=\"type-badge type-Normal\" onmousemove=\"window.showTypeTooltip('Normal', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Normal</span></div> </div> <div class=\"pc-card-actions\"><button type=\"button\" class=\"pc-card-btn pc-card-btn--deposit\" onclick=\"event.stopPropagation();window.StoryMode.pcDeposit('fix-eevee')\" title=\"\">Deposit</button></div> </div>",
  "PC_PARTY_EGG": "<div class=\"pc-card pc-card--egg\" data-pc-row=\"party\" data-pc-id=\"egg-party\"> <div class=\"pc-card-hit\" role=\"button\" tabindex=\"0\" data-pc-open=\"1\" aria-label=\"Mystery Egg\" title=\"It's an egg\"> <div class=\"pc-card-sprite-wrap pc-card-sprite-wrap--egg\"><span style=\"display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;font-size:34px;line-height:1;flex-shrink:0;filter:drop-shadow(0 0 3px rgba(255,213,79,0.5));\">🥚</span></div> <div class=\"pc-card-name\">🥚 Mystery Egg</div> <div class=\"pc-card-sub\">hatches a couple of towns on</div> </div> <div class=\"pc-card-actions\"><button type=\"button\" class=\"pc-card-btn pc-card-btn--deposit\" onclick=\"event.stopPropagation();window.StoryMode.pcDeposit('egg-party')\" title=\"\">Deposit</button></div> </div>",
  "PC_BOX": "<div class=\"pc-card tier-1\" data-pc-row=\"pc\" data-pc-id=\"box-garchomp\"> <div class=\"pc-card-hit\" role=\"button\" tabindex=\"0\" data-pc-open=\"1\" aria-label=\"View Garchomp summary\" title=\"View full summary\"> <div class=\"pc-card-sprite-wrap\"> <img src=\"sprites/gen5ani/garchomp.gif\" alt=\"\" class=\"pc-card-sprite\" data-shiny=\"false\" style=\"\" onerror=\"this.style.display='none'\"> <span class=\"pc-card-grade\"><span style=\"display:inline-block;font-size:9px;font-weight:bold;color:#111;background:#ce93d8;padding:1px 5px;border-radius:0;letter-spacing:0.04em;\">G1</span></span> </div> <div class=\"pc-card-name\">Garchomp</div> <div class=\"pc-card-types\"><span class=\"type-badge type-Dragon\" onmousemove=\"window.showTypeTooltip('Dragon', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Dragon</span><span class=\"type-badge type-Ground\" onmousemove=\"window.showTypeTooltip('Ground', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Ground</span></div> </div> <div class=\"pc-card-actions\"><button type=\"button\" class=\"pc-card-btn pc-card-btn--withdraw\" onclick=\"event.stopPropagation();window.StoryMode.pcWithdraw('box-garchomp')\" title=\"\">Withdraw</button><button type=\"button\" class=\"pc-card-btn pc-card-btn--release\" onclick=\"event.stopPropagation();window.StoryMode.pcRelease('box-garchomp')\" title=\"Release Garchomp\">Release</button></div> </div>",
  "PC_BOX_EGG": "<div class=\"pc-card pc-card--egg\" data-pc-row=\"pc\" data-pc-id=\"egg-box\"> <div class=\"pc-card-hit\" role=\"button\" tabindex=\"0\" data-pc-open=\"1\" aria-label=\"Mystery Egg\" title=\"It's an egg\"> <div class=\"pc-card-sprite-wrap pc-card-sprite-wrap--egg\"><span style=\"display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;font-size:34px;line-height:1;flex-shrink:0;filter:drop-shadow(0 0 3px rgba(255,213,79,0.5));\">🥚</span></div> <div class=\"pc-card-name\">🥚 Mystery Egg</div> <div class=\"pc-card-sub\">hatches a couple of towns on</div> </div> <div class=\"pc-card-actions\"><button type=\"button\" class=\"pc-card-btn pc-card-btn--withdraw\" onclick=\"event.stopPropagation();window.StoryMode.pcWithdraw('egg-box')\" title=\"\">Withdraw</button><button type=\"button\" class=\"pc-card-btn pc-card-btn--release\" onclick=\"event.stopPropagation();window.StoryMode.pcRelease('egg-box')\" title=\"Release this egg\">Release</button></div> </div>",
  "PRR_LEAD": "<div class=\"party-reorder-row party-row tier-1\" data-party-idx=\"0\"> <div class=\"party-drag-handle\" title=\"Drag to reorder\" aria-hidden=\"true\"></div> <div class=\"story-party-card-hit\" role=\"button\" tabindex=\"0\" data-party-idx=\"0\" title=\"View summary\" aria-label=\"View Garchomp summary\"> <div class=\"prr-sprite\"> <img src=\"sprites/gen5ani/garchomp.gif\" onerror=\"handleSpriteError(this)\" alt=\"Garchomp\" data-shiny=\"false\" class=\"mini-sprite\" style=\"\"> <span class=\"tier-badge bg-tier-1\" title=\"Grade (1 = strongest pool tier, 4 = cutest/weakest)\">G1</span> </div> <div class=\"prr-body\"> <div class=\"prr-line1\"><span class=\"party-lead-flag\" title=\"Battles start with this Pokémon\">LEAD</span><span class=\"prr-name\">Garchomp</span> <span class=\"type-badge type-Dragon\" onmousemove=\"window.showTypeTooltip('Dragon', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Dragon</span><span class=\"type-badge type-Ground\" onmousemove=\"window.showTypeTooltip('Ground', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Ground</span></div> <div class=\"prr-info\">Life Orb · Rough Skin · Jolly</div> </div> </div> <div class=\"party-sort-col\" onclick=\"event.stopPropagation()\"> <button type=\"button\" class=\"party-lead-btn\" title=\"Send to the front (make lead)\" disabled=\"\" onclick=\"event.stopPropagation();window.StoryMode.setPartyLead(0)\" aria-label=\"Make lead\">⤒</button> <button type=\"button\" class=\"party-sort-btn\" title=\"Move up in party\" disabled=\"\" onclick=\"event.stopPropagation();window.StoryMode.moveInParty(0,-1)\" aria-label=\"Move up\">▲</button> <button type=\"button\" class=\"party-sort-btn\" title=\"Move down in party\" onclick=\"event.stopPropagation();window.StoryMode.moveInParty(0,1)\" aria-label=\"Move down\">▼</button> </div> </div>",
  "PRR_NICK": "<div class=\"party-reorder-row party-row tier-4\" data-party-idx=\"1\"> <div class=\"party-drag-handle\" title=\"Drag to reorder\" aria-hidden=\"true\"></div> <div class=\"story-party-card-hit\" role=\"button\" tabindex=\"0\" data-party-idx=\"1\" title=\"View summary\" aria-label=\"View Fluffy summary\"> <div class=\"prr-sprite\"> <img src=\"sprites/gen5ani/eevee.gif\" onerror=\"handleSpriteError(this)\" alt=\"Eevee\" data-shiny=\"false\" class=\"mini-sprite\" style=\"\"> <span class=\"tier-badge bg-tier-4\" title=\"Grade (1 = strongest pool tier, 4 = cutest/weakest)\">G4</span> </div> <div class=\"prr-body\"> <div class=\"prr-line1\"><span class=\"party-slot-num\">#2</span><span class=\"prr-name\">\"Fluffy\" <span style=\"color:#888;font-size:10px;font-weight:normal;\">(Eevee)</span></span> <span class=\"type-badge type-Normal\" onmousemove=\"window.showTypeTooltip('Normal', event)\" onmouseleave=\"window.hideTextTooltip()\" style=\"cursor:help;\">Normal</span></div> <div class=\"prr-info\">No Item · Adaptability · Hardy</div> </div> </div> <div class=\"party-sort-col\" onclick=\"event.stopPropagation()\"> <button type=\"button\" class=\"party-lead-btn\" title=\"Send to the front (make lead)\" onclick=\"event.stopPropagation();window.StoryMode.setPartyLead(1)\" aria-label=\"Make lead\">⤒</button> <button type=\"button\" class=\"party-sort-btn\" title=\"Move up in party\" onclick=\"event.stopPropagation();window.StoryMode.moveInParty(1,-1)\" aria-label=\"Move up\">▲</button> <button type=\"button\" class=\"party-sort-btn\" title=\"Move down in party\" onclick=\"event.stopPropagation();window.StoryMode.moveInParty(1,1)\" aria-label=\"Move down\">▼</button> </div> </div>",
  "PRR_EGG": "<div class=\"party-reorder-row party-reorder-row--egg party-row\" data-party-idx=\"2\"> <div class=\"party-drag-handle\" title=\"Drag to reorder\" aria-hidden=\"true\"></div> <div class=\"story-party-card-hit\" role=\"button\" tabindex=\"0\" data-party-idx=\"2\" title=\"It's an egg\" aria-label=\"Mystery Egg\"> <div class=\"prr-sprite\"><span style=\"display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;font-size:28px;line-height:1;flex-shrink:0;filter:drop-shadow(0 0 3px rgba(255,213,79,0.5));\">🥚</span></div> <div class=\"prr-body\"> <div class=\"prr-line1\"><span class=\"party-slot-num\">#3</span><span class=\"prr-name\">🥚 Mystery Egg</span></div> <div class=\"prr-info\" style=\"color:#ffd54f;white-space:normal;\">Something stirs inside — hatches in a couple of towns.</div> </div> </div> <div class=\"party-sort-col\" onclick=\"event.stopPropagation()\"> <button type=\"button\" class=\"party-lead-btn\" title=\"Send to the front (make lead)\" onclick=\"event.stopPropagation();window.StoryMode.setPartyLead(2)\" aria-label=\"Make lead\">⤒</button> <button type=\"button\" class=\"party-sort-btn\" title=\"Move up in party\" onclick=\"event.stopPropagation();window.StoryMode.moveInParty(2,-1)\" aria-label=\"Move up\">▲</button> <button type=\"button\" class=\"party-sort-btn\" title=\"Move down in party\" disabled=\"\" onclick=\"event.stopPropagation();window.StoryMode.moveInParty(2,1)\" aria-label=\"Move down\">▼</button> </div> </div>"
