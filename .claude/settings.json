{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run audit:*)",
      "Bash(npm run audit)",
      "Bash(npm install:*)",
      "Bash(npm install)",
      "Bash(npm ci:*)",
      "Bash(npm ci)",
      "Bash(npm run lint:*)",
      "Bash(npm run debug:*)",
      "Bash(npm run test:*)",
      "Bash(node scripts/**)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(node -e:*)",
      "Bash(npx eslint:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
